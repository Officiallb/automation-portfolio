      "name": "Get Leads",
      "retryOnFail": true,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst s = (v) => (v === undefined || v === null) ? '' : String(v).trim();\n\nif (!s(cfg.from_number).startsWith('+') || s(cfg.from_number).includes('REPLACE')) {\n  throw new Error('Set from_number (your Retell number, E.164) in the Config node first');\n}\n\nconst max = Number(cfg.max_calls) || 1;\nconst validPhone = (p) => p.length >= 9 && p.startsWith('+') && [...p.slice(1)].every(c => c >= '0' && c <= '9');\n\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  const phone = s(r.phone_number);\n  if (!s(r.lead_id) || !validPhone(phone)) continue;\n  if (s(r.status) !== 'Not Called') continue;\n\n  // Every dynamic variable must be a string for Retell\n  out.push({\n    json: {\n      lead_id: s(r.lead_id),\n      phone_number: phone,\n      request_body: {\n        from_number: s(cfg.from_number),\n        to_number: phone,\n        override_agent_id: s(cfg.agent_id),\n        retell_llm_dynamic_variables: {\n          lead_id: s(r.lead_id),\n          customer_name: s(r.customer_name),\n          customer_phone: phone,\n          lead_source: s(r.lead_source),\n          lead_details: s(r.lead_details),\n          property_address: s(r.property_address)\n        },\n        metadata: { lead_id: s(r.lead_id) }\n      }\n    }\n  });\n  if (out.length >= max) break;\n}\nreturn out;"
      },
