    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst call = body.call || {};\nconst analysis = call.call_analysis || {};\nconst custom = analysis.custom_analysis_data || {};\nconst vars = Object.assign({}, call.collected_dynamic_variables, call.retell_llm_dynamic_variables);\n\n// One timezone for the call date. Change it here only.\nconst TZ = 'America/New_York';\n\nconst clean = (v) => (v === undefined || v === null) ? '' : String(v).trim();\n\nconst start = call.start_timestamp ? DateTime.fromMillis(call.start_timestamp).setZone(TZ) : null;\nconst ms = call.duration_ms || 0;\nconst cents = (call.call_cost && call.call_cost.combined_cost) || 0;\n\nreturn [{\n  json: {\n    event: body.event || '',\n    call_id: clean(call.call_id),\n    call_status: clean(call.call_status),\n    disconnection_reason: clean(call.disconnection_reason),\n    // lead_id comes back from the dynamic variables (batch CSV or API), or from metadata (API only)\n    lead_id: clean(vars.lead_id) || clean((call.metadata || {}).lead_id),\n    phone: clean(call.to_number) || clean(vars.customer_phone) || clean(vars.phone_number),\n    date: start ? start.toFormat('LLL dd, yyyy HH:mm:ss') : '',\n    last_call_date: start ? start.toFormat('yyyy-LL-dd') : '',\n    duration: Math.floor(ms / 60000) + 'm ' + Math.floor((ms % 60000) / 1000) + 's',\n    cost: (cents / 100).toFixed(3),\n    recording: clean(call.recording_url),\n    call_summary: clean(analysis.call_summary),\n    call_successful: analysis.call_successful === undefined ? '' : String(analysis.call_successful),\n    user_sentiment: clean(analysis.user_sentiment),\n    outcome: clean(custom.outcome),\n    still_interested: clean(custom.still_interested),\n    roof_issue: clean(custom.roof_issue),\n    alternate_phone_number: clean(custom.alternate_phone_number),\n    updated_customer_name: clean(custom.updated_customer_name),\n    updated_property_address: clean(custom.updated_property_address),\n    booking_note: clean(custom.booking_note)\n  }\n}];"
      },
