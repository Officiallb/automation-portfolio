      "id": "9e2e8a89-a167-44cb-93ba-89cb6de74fb9",
      "name": "Find Lead",
      "retryOnFail": true,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const call = $('Extract Call Data').first().json;\nconst row = $input.first().json;\n\nconst keep = (updated, current) => {\n  const u = (updated === undefined || updated === null) ? '' : String(updated).trim();\n  return u ? u : ((current === undefined || current === null) ? '' : String(current));\n};\n\n// Turn a spoken phone number into +international format. Returns '' when it can't be trusted,\n// in which case the original phone_number stays.\nconst toE164 = (raw) => {\n  const p = (raw === undefined || raw === null) ? '' : String(raw).trim();\n  if (!p) return '';\n  const digits = [...p].filter(c => c >= '0' && c <= '9').join('');\n  if (p.startsWith('+')) return (digits.length >= 8 && digits.length <= 15) ? '+' + digits : '';\n  if (digits.length === 10) return '+1' + digits;                       // assumes a US number\n  if (digits.length === 11 && digits.startsWith('1')) return '+' + digits;\n  return '';\n};\n\n// New value from the call replaces the old one; otherwise the old one stays\nreturn [{\n  json: {\n    lead_id: call.lead_id,\n    customer_name: keep(call.updated_customer_name, row.customer_name),\n    phone_number: toE164(call.alternate_phone_number) || keep('', row.phone_number),\n    property_address: keep(call.updated_property_address, row.property_address),\n    status: 'Called',\n    last_call_date: call.last_call_date,\n    still_interested: keep(call.still_interested, row.still_interested),\n    outcome: keep(call.outcome, row.outcome),\n    roof_issue: keep(call.roof_issue, row.roof_issue),\n    booking_note: keep(call.booking_note, row.booking_note),\n    call_summary: keep(call.call_summary, row.call_summary)\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
