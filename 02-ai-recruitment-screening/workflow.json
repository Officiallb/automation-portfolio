      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"skills\": {\n      \"type\": \"string\",\n      \"description\": \"List of technical skills, comma-separated\"\n    },\n    \"years_of_experience\": {\n      \"type\": \"number\",\n      \"minimum\": 0\n    },\n    \"education\": {\n      \"type\": \"string\"\n    },\n    \"profile_summary\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"skills\",\n    \"years_of_experience\",\n    \"education\",\n    \"profile_summary\"\n  ],\n  \"additionalProperties\": false\n}"
