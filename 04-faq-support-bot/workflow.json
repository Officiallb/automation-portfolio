{
  "name": "FAQ Support Bot",
  "nodes": [
    {
      "parameters": {
        "content": "## Flow 1: Load the FAQ\nWatches a Google Drive folder for a new Google Doc, splits it into chunks, embeds it with Gemini and stores the chunks in Supabase.\n\nRun this whenever the FAQ document changes.",
        "height": 720,
        "width": 1000,
        "color": 4
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -160
      ],
      "id": "0deb8d41-7b72-47db-a08f-3a3ebaa75599",
      "name": "Note: Flow 1"
    },
    {
      "parameters": {
        "content": "## Flow 2: Answer customers\nA customer messages the Telegram bot. The agent searches the FAQ in Supabase and replies. Every question is logged in Google Sheets, and Slack is alerted when the FAQ did not have the answer.",
        "height": 760,
        "width": 1760,
        "color": 5
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        520
      ],
      "id": "e898c2f2-a5ad-4fda-8e4a-3373a4f6bfe5",
      "name": "Note: Flow 2"
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "event": "fileCreated",
        "options": {
          "fileType": "application/vnd.google-apps.document"
        }
      },
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "5bc26611-065f-46a3-b51e-869b08c69dba",
      "name": "New FAQ Document"
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        },
        "options": {
          "googleFileConversion": {
            "conversion": {
              "docsToFormat": "text/plain"
            }
          }
        }
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        224,
        0
      ],
      "id": "6160aa22-10ac-4d1a-9a6e-25d8461cc20b",
      "name": "Download FAQ Document"
    },
    {
      "parameters": {
        "mode": "insert",
        "tableName": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "options": {}
      },
