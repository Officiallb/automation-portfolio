      "typeVersion": 1,
      "position": [
        368,
        220
      ],
      "id": "950349c9-8108-4a29-b4c4-e7888b1ed072",
      "name": "Embed Document (Gemini)"
    },
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        700
      ],
      "id": "9bb741e1-649d-44a6-8bc4-02375ee8076f",
      "name": "On Customer Message"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=# Role\nYou are NovaTech Support AI. You answer customer questions about NovaTech's products, services and policies.\n\n# How to answer\n1. Always search the FAQ tool first, even if you think you know the answer.\n2. Answer only from what the FAQ tool returns. Never invent policies, prices or dates.\n3. Reply in the language of the customer's message. Keep the answer short, clear and polite.\n4. If the FAQ does not contain the answer, say you could not find that information and set human_needed to \"yes\". Do not promise that a person will contact them.\n\n# Output\nReturn JSON with two fields:\n- response: the text to send to the customer.\n- human_needed: \"no\" if the FAQ fully answered the question, otherwise \"yes\". Use lowercase only."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [
        448,
        700
      ],
      "id": "1a1f85b8-367a-4f9f-bcc3-a40ed9576125",
      "name": "Support Agent"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        300,
        940
      ],
      "id": "db9a45a7-4f2a-455b-90a2-c41215778963",
      "name": "Gemini Chat Model"
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $json.message.chat.id }}"
      },
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        440,
        940
      ],
      "id": "63c2f1d3-d7f7-4e2d-adaa-de2b977ee669",
      "name": "Conversation Memory"
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Search the company's FAQ and policy database. Use it for every customer question.",
