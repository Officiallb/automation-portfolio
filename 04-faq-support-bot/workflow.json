      "typeVersion": 1.1,
      "position": [
        528,
        220
      ],
      "id": "2200b91c-e33d-49c7-a806-3903e0637302",
      "name": "Document Loader"
    },
    {
      "parameters": {
        "chunkSize": 500,
        "chunkOverlap": 20,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        528,
        400
      ],
